    "print(\"Mean CV RMSE:\", rmse_best_rf.mean())\n",
    "print(\"Std CV RMSE:\", rmse_best_rf.std())\n",
    "\n",
    "oof_pred = cross_val_predict(# obtain predictions for observations the model did not see during training\n",
    "    best_model_rf,\n",
