    ")\n",
    "\n",
    "X_exp_11[\"HouseAge\"] = (\n",
    "    X_exp_11[\"YrSold\"] - X_exp_11[\"YearBuilt\"]\n",
    ")\n",
    "\n",
    "numeric_cols_exp = X_exp_11.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp_11.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "evaluate_model(model_exp, X_exp_11, y_log)# combined features did not provide a useful improvement\n",
    "\n",
    "# Build the clean baseline feature set.\n",
    "# Do not mutate train/test here: create X_exp2 explicitly.\n",
    "def make_preprocessor(X):\n",
    "    numeric_cols = X.select_dtypes(include=np.number).columns\n",
    "    categorical_cols = X.select_dtypes(\n",
    "        include=[\"object\", \"string\", \"category\"]\n",
    "    ).columns\n",
    "\n",
    "    return ColumnTransformer([\n",
    "        (\"num\", numeric_transformer, numeric_cols),\n",
    "        (\"cat\", categorical_transformer, categorical_cols)\n",
    "    ])\n",
    "\n",
    "# Use the original feature set for the baseline tree model.\n",
    "X_tree = X.copy()\n",
    "y_log = np.log1p(train[\"SalePrice\"])\n",
    "preprocessor_tree = make_preprocessor(X_tree)\n",
    "model_tree = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_tree),\n",
    "    (\"regressor\", DecisionTreeRegressor(random_state=42))\n",
    "])\n",
    "\n",
    "\n",
    "\n",
    "cv = KFold(# model evaluation\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "scores_tree = cross_val_score(\n",
    "    model_tree,\n",
    "    X,\n",
    "    y_log,\n",
    "    cv=cv,\n",
    "    scoring=\"neg_root_mean_squared_error\"\n",
    ")\n",
    "\n",
    "rmse_scores = -scores_tree\n",
    "\n",
    "\n",
    "\n",
    "print(\"\\nRMSE for each fold:\")\n",
    "print(rmse_scores)\n",
    "print(\"\\nMean CV RMSE:\", rmse_scores.mean())\n",
    "print(\"Std CV RMSE:\", rmse_scores.std())\n",
    "\n",
    "# Use the original feature set for the baseline random forest.\n",
    "X_rf = X.copy()\n",
    "y_log = np.log1p(train[\"SalePrice\"])\n",
    "preprocessor_rf = make_preprocessor(X_rf)\n",
    "model_forest = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_rf),\n",
    "    (\"regressor\", RandomForestRegressor(\n",
    "        n_estimators=300,\n",
    "        random_state=42,\n",
    "        n_jobs=-1))\n",
    "])\n",
    "\n",
    "cv = KFold(# model evaluation\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "scores_forest = cross_val_score(\n",
    "    model_forest,\n",
    "    X,\n",
    "    y_log,\n",
    "    cv=cv,\n",
    "    scoring=\"neg_root_mean_squared_error\"\n",
    ")\n",
    "\n",
    "rmse_scores = -scores_forest\n",
    "\n",
    "print(\"\\nRMSE for each fold:\")\n",
    "print(rmse_scores)\n",
    "print(\"\\nMean CV RMSE:\", rmse_scores.mean())\n",
    "print(\"Std CV RMSE:\", rmse_scores.std())\n",
    "\n",
    "# Clean baseline: original X without engineered features.\n",
    "X_exp2 = X.copy()\n",
    "y_log = np.log1p(train[\"SalePrice\"])\n",
    "\n",
    "preprocessor_rf_exp2 = make_preprocessor(X_exp2)\n",
    "\n",
    "model_forest_exp2 = Pipeline([\n",
