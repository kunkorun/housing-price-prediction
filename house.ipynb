    "    X_exp2,\n",
    "    y_log,\n",
    "    cv=cv,\n",
    "    scoring=\"neg_root_mean_squared_error\"\n",
    ")\n",
    "\n",
    "rmse_scores = -scores_forest_exp2\n",
    "\n",
    "\n",
    "\n",
    "print(\"\\nRMSE for each fold:\")\n",
    "print(rmse_scores)\n",
    "print(\"\\nMean CV RMSE:\", rmse_scores.mean())\n",
    "print(\"Std CV RMSE:\", rmse_scores.std())\n",
    "\n",
    "param_dist = {\n",
    "    \"regressor__n_estimators\": [200, 300, 500, 800],\n",
    "    \"regressor__max_depth\": [None, 10, 15, 20, 25, 30],\n",
    "    \"regressor__min_samples_split\": [2, 5, 10],\n",
    "    \"regressor__min_samples_leaf\": [1, 2, 4],\n",
    "    \"regressor__max_features\": [\"sqrt\", \"log2\", 0.5, 0.8, 1.0]\n",
