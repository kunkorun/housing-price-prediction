    "\n",
    "rf = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_rf_tuning),\n",
    "    (\"regressor\", RandomForestRegressor(\n",
    "        random_state=42,\n",
    "        n_jobs=1\n",
    "    ))\n",
