    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import LinearRegression, RidgeCV\n",
    "from sklearn.model_selection import KFold, RandomizedSearchCV, cross_val_predict, cross_val_score\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder\n",
    "from sklearn.tree import DecisionTreeRegressor\n",
    "\n",
    "test = pd.read_csv('/kaggle/input/competitions/house-prices-advanced-regression-techniques/test.csv')\n",
    "train = pd.read_csv('/kaggle/input/competitions/house-prices-advanced-regression-techniques/train.csv')\n",
    "\n",
    "# Data loading and inspection\n",
    "# NOTE: these manual imputations are fit on the full training set.\n",
    "# For strictly leakage-free CV, preprocessing should be fitted inside each CV fold.\n",
    "# The modeling pipelines below still handle any remaining missing values.\n",
    "\n",
    "# Calculate LotFrontage median by Neighborhood using the training set\n",
    "neighborhood_median = (\n",
    "    train.groupby(\"Neighborhood\")[\"LotFrontage\"]\n",
    "    .median()\n",
    ")\n",
    "\n",
    "# inspect the data and replace NaN in test and train\n",
    "train.head()\n",
    "\n",
    "overall_median = train[\"LotFrontage\"].median()\n",
    "\n",
    "train[\"LotFrontage\"] = (\n",
    "    train[\"LotFrontage\"]\n",
    "    .fillna(train[\"Neighborhood\"].map(neighborhood_median))\n",
    "    .fillna(overall_median)\n",
    ")\n",
    "\n",
    "# 4. Categorical, where NaN = unknown value\n",
    "none_cols = [\n",
    "    \"Alley\",\n",
    "    \"MasVnrType\",\n",
    "    \"BsmtQual\",\n",
    "    \"BsmtCond\",\n",
    "    \"BsmtExposure\",\n",
    "    \"BsmtFinType1\",\n",
    "    \"BsmtFinType2\",\n",
    "    \"FireplaceQu\",\n",
    "    \"GarageType\",\n",
    "    \"GarageFinish\",\n",
    "    \"GarageQual\",\n",
    "    \"GarageCond\",\n",
    "    \"PoolQC\",\n",
    "    \"Fence\",\n",
    "    \"MiscFeature\"\n",
    "]\n",
    "\n",
    "for col in none_cols:\n",
    "    train[col] = train[col].fillna(\"None\")\n",
    "\n",
    "\n",
    "zero_cols = [\n",
    "    \"MasVnrArea\",\n",
    "    \"GarageYrBlt\",\n",
    "    \"BsmtFullBath\",\n",
    "    \"BsmtHalfBath\",\n",
    "    \"BsmtFinSF1\",\n",
    "    \"BsmtFinSF2\",\n",
    "    \"BsmtUnfSF\",\n",
    "    \"TotalBsmtSF\",\n",
    "    \"GarageArea\",\n",
    "    \"GarageCars\"\n",
    "]\n",
    "\n",
    "for col in zero_cols:\n",
    "    train[col] = train[col].fillna(0)\n",
    "\n",
    "\n",
    "train[\"Electrical\"] = train[\"Electrical\"].fillna(\n",
    "    train[\"Electrical\"].mode()[0]\n",
    ")\n",
    "\n",
    "print(\"Missing LotFrontage:\", train[\"LotFrontage\"].isna().sum())\n",
    "print(\"Missing values in train:\", train.isna().sum().sum())\n",
    "\n",
    "\n",
    "# Test cleaning\n",
    "\n",
    "for col in none_cols:\n",
    "    test[col] = test[col].fillna(\"None\")\n",
    "\n",
    "\n",
    "for col in zero_cols:\n",
    "    test[col] = test[col].fillna(0)\n",
    "\n",
    "\n",
    "train_lotfrontage_median = train[\"LotFrontage\"].median()\n",
    "\n",
    "test[\"LotFrontage\"] = (\n",
    "    test[\"LotFrontage\"]\n",
    "    .fillna(test[\"Neighborhood\"].map(neighborhood_median))\n",
    "    .fillna(train_lotfrontage_median)\n",
    ")\n",
    "\n",
    "\n",
    "mode_cols = [\n",
    "    \"MSZoning\",\n",
    "    \"Utilities\",\n",
    "    \"Exterior1st\",\n",
    "    \"Exterior2nd\",\n",
    "    \"KitchenQual\",\n",
    "    \"Functional\",\n",
    "    \"SaleType\"\n",
    "]\n",
    "\n",
    "for col in mode_cols:\n",
    "    mode = train[col].mode()[0]\n",
    "    test[col] = test[col].fillna(mode)\n",
    "\n",
    "\n",
    "print(\"Total missing values in test:\", test.isna().sum().sum())\n",
    "\n",
    "train[\"SalePrice\"].describe()\n",
    "\n",
    "train[\"SalePrice\"].hist(bins=50)# the distribution is not normal; there are outliers, i.e. very expensive houses\n",
    "\n",
    "train[\"SalePrice\"].skew()# right-skewed due to outliers\n",
    "\n",
    "numeric_cols = train.select_dtypes(include=\"number\")\n",
    "corr = numeric_cols.corr()\n",
    "\n",
    "plt.figure(figsize=(14, 10))\n",
    "sns.heatmap(corr, cmap=\"coolwarm\")\n",
    "plt.show()\n",
    "\n",
    "sns.scatterplot(data=train, x=\"GrLivArea\", y=\"SalePrice\")# approximately linear relationship; there are outliers\n",
    "plt.show()\n",
    "\n",
    "sns.scatterplot(data=train, x=\"OverallQual\", y=\"SalePrice\")# the relationship is stepped; there are price jumps\n",
    "plt.show()\n",
    "\n",
    "sns.scatterplot(data=train, x=\"GarageCars\", y=\"SalePrice\")# there is a sharp drop at 4 cars\n",
    "plt.show()\n",
    "\n",
    "sns.scatterplot(data=train, x=\"GarageArea\", y=\"SalePrice\")#approximately linear relationship; there are outliers.\n",
    "plt.show()\n",
    "\n",
    "sns.scatterplot(data=train, x=\"GarageCars\", y=\"GarageArea\")\n",
    "plt.show()\n",
    "\n",
    "sns.scatterplot(data=train, x=\"BsmtFullBath\", y=\"SalePrice\")\n",
    "plt.show()\n",
    "\n",
    "sns.scatterplot(data=train, x=\"TotRmsAbvGrd\", y=\"GrLivArea\")\n",
    "plt.show()# approximately linear relationship; there are outliers\n",
    "\n",
    "train[train[\"GarageCars\"] == 4][[\"GarageCars\", \"GarageArea\", \"SalePrice\"]]# there are few houses with GarageCars = 4, so it is too early to draw conclusions\n",
    "\n",
    "train[[\"GarageCars\", \"GarageArea\"]].corr()# strong relationship\n",
    "\n",
    "train[[\"GrLivArea\", \"TotRmsAbvGrd\"]].corr()# strong relationship\n",
    "\n",
    "# brief summary so far - OverallQual, GrLivArea, GarageCars, GarageArea, and TotRmsAbvGrd have a noticeable relationship with SalePrice. \n",
    "# BsmtFullBath did not show an obvious relationship. GarageCars/GarageArea and GrLivArea/TotRmsAbvGrd are strongly correlated with each other, \n",
    "# so their interchangeability should be tested experimentally.\n",
    "\n",
    "X = train.drop(columns=[\"SalePrice\"])\n",
    "y = train[\"SalePrice\"]\n",
    "\n",
    "y_log = np.log1p(y)# apply a log transformation to prices for Kaggle\n",
    "\n",
    "\n",
    "numeric_cols = X.select_dtypes(\n",
    "    include=[\"int64\", \"float64\"]\n",
    ").columns\n",
    "\n",
    "categorical_cols = X.select_dtypes(\n",
    "    include=[\"object\"]# split into feature types\n",
    ").columns\n",
    "\n",
    "\n",
    "print(\"Number of numerical features:\", len(numeric_cols))\n",
    "print(\"Number of categorical features:\", len(categorical_cols))\n",
    "\n",
    "\n",
    "\n",
    "numeric_transformer = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"median\"))# data preprocessing\n",
    "])\n",
    "\n",
    "categorical_transformer = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "    (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))# data preprocessing\n",
    "])\n",
    "\n",
    "\n",
    "preprocessor = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols),\n",
    "    (\"cat\", categorical_transformer, categorical_cols)# data preprocessing\n",
    "])\n",
    "\n",
    "\n",
    "model = Pipeline([\n",
    "    (\"preprocessor\", preprocessor),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "\n",
    "\n",
    "cv = KFold(# model evaluation\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "scores = cross_val_score(\n",
    "    model,\n",
    "    X,\n",
    "    y_log,\n",
    "    cv=cv,\n",
    "    scoring=\"neg_root_mean_squared_error\"\n",
    ")\n",
    "\n",
    "rmse_scores = -scores\n",
    "\n",
    "\n",
    "\n",
    "print(\"\\nRMSE for each fold:\")\n",
    "print(rmse_scores)\n",
    "print(\"\\nMean CV RMSE:\", rmse_scores.mean())\n",
    "print(\"Std CV RMSE:\", rmse_scores.std())\n",
    "\n",
    "def evaluate_model(model, X, y, cv=cv):\n",
    "    scores = cross_val_score(\n",
    "        model, X, y, cv=cv,\n",
    "        scoring=\"neg_root_mean_squared_error\"\n",
    "    )\n",
    "    rmse_scores = -scores\n",
    "    \n",
    "    print(\"\\nRMSE for each fold:\")\n",
    "    print(rmse_scores)\n",
    "    print(\"\\nMean CV RMSE:\", rmse_scores.mean())\n",
    "    print(\"Std CV RMSE:\", rmse_scores.std())\n",
    "    \n",
    "\n",
    "X_exp = X.drop(columns=[\"GarageArea\"])\n",
    "\n",
    "numeric_cols_exp = X_exp.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp, y_log)# GarageArea is not critically necessary for Linear Regression\n",
    "                                        # removing it did not materially reduce performance\n",
    "\n",
    "X_exp = X.drop(columns=[\"GarageCars\"])\n",
    "\n",
    "numeric_cols_exp = X_exp.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp, y_log)\n",
    "# For this Linear Regression model, GarageCars appears slightly more useful than GarageArea despite their strong correlation\n",
    "\n",
    "X_exp = X.drop(columns=[\"TotRmsAbvGrd\"])\n",
    "\n",
    "numeric_cols_exp = X_exp.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp, y_log)\n",
    "# Removing TotRmsAbvGrd worsened the result\n",
    "\n",
    "X_exp = X.drop(columns=[\"GrLivArea\"])\n",
    "\n",
    "numeric_cols_exp = X_exp.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp, y_log)\n",
    "\n",
    "'''\n",
    "GarageCars and GarageArea are strongly correlated, but both may contain useful information. \n",
    "GrLivArea and TotRmsAbvGrd are also strongly correlated, but removing either one worsens CV RMSE. \n",
    "'''\n",
    "\n",
    "# train Ridge model\n",
    "ridge_model = Pipeline([\n",
    "    (\"preprocessor\", preprocessor),\n",
    "    (\"regressor\", RidgeCV(\n",
    "        alphas=[0.01, 0.1, 1, 10, 100],\n",
    "        cv=cv,\n",
    "        scoring=\"neg_root_mean_squared_error\"\n",
    "    ))\n",
    "])\n",
    "ridge_model.fit(X, y_log)\n",
    "\n",
    "ridge = ridge_model.named_steps[\"regressor\"]\n",
    "\n",
    "print(\"Best alpha:\", ridge.alpha_)\n",
    "\n",
    "scores = cross_val_score(\n",
    "    ridge_model,\n",
    "    X,\n",
    "    y_log,\n",
    "    cv=cv,\n",
    "    scoring=\"neg_root_mean_squared_error\"\n",
    ")\n",
    "\n",
    "rmse_scores = -scores\n",
    "\n",
    "print(\"RMSE for each fold:\")\n",
    "print(rmse_scores)\n",
    "\n",
    "print(\"Mean CV RMSE:\", rmse_scores.mean())\n",
    "print(\"Std CV RMSE:\", rmse_scores.std())\n",
    "\n",
    "# brief summary - Ridge Regression performed worse than the baseline, so for now we keep Linear Regression as the best linear model.\n",
    "\n",
    "train[\"TotalSF\"] = (\n",
    "    train[\"TotalBsmtSF\"]\n",
    "    + train[\"1stFlrSF\"]\n",
    "    + train[\"2ndFlrSF\"]\n",
    ")\n",
    "\n",
    "train[[\"TotalSF\", \"SalePrice\"]].corr()\n",
    "\n",
    "test[\"TotalSF\"] = (\n",
    "    test[\"TotalBsmtSF\"]\n",
    "    + test[\"1stFlrSF\"]\n",
    "    + test[\"2ndFlrSF\"]\n",
    ")\n",
    "\n",
    "sns.scatterplot(data=train, x=\"TotalSF\", y=\"SalePrice\")\n",
    "plt.show()\n",
    "\n",
    "train.loc[\n",
    "    train[\"TotalSF\"] > 7000,\n",
    "    [\"TotalSF\", \"SalePrice\", \"GrLivArea\", \"TotalBsmtSF\", \"1stFlrSF\", \"2ndFlrSF\"]\n",
    "].sort_values(\"TotalSF\")\n",
    "\n",
    "X_exp_TotalSF =  X.copy()\n",
    "X_exp_TotalSF[\"TotalSF\"] = (\n",
    "    X_exp_TotalSF[\"TotalBsmtSF\"]\n",
    "    + X_exp_TotalSF[\"1stFlrSF\"]\n",
    "    + X_exp_TotalSF[\"2ndFlrSF\"]\n",
    ")\n",
    "\n",
    "numeric_cols_exp = X_exp_TotalSF.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp_TotalSF.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp_TotalSF, y_log)\n",
    "\n",
    "train[\"GarageInteraction\"] = (\n",
    "    train[\"GarageCars\"] * train[\"GarageArea\"]\n",
    ")\n",
    "train[[\"GarageInteraction\", \"SalePrice\"]].corr()\n",
    "\n",
    "sns.scatterplot(data=train, x=\"GarageInteraction\", y=\"SalePrice\")\n",
    "plt.show()\n",
    "\n",
    "test[\"GarageInteraction\"] = (\n",
    "    test[\"GarageCars\"] * test[\"GarageArea\"]\n",
    ")\n",
    "\n",
    "train.groupby(\"GarageCars\")[\"GarageArea\"].mean()\n",
    "\n",
    "X_exp_Garage = X.copy()\n",
    "X_exp_Garage[\"GarageInteraction\"] = (\n",
    "    X_exp_Garage[\"GarageCars\"] * X_exp_Garage[\"GarageArea\"]\n",
    ")\n",
    "\n",
    "numeric_cols_exp = X_exp_Garage.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp_Garage.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp_Garage, y_log)\n",
    "\n",
    "train[\"HouseAge\"] = train[\"YrSold\"] - train[\"YearBuilt\"]\n",
    "train[[\"HouseAge\", \"SalePrice\"]].corr()\n",
    "\n",
    "test[\"HouseAge\"] = test[\"YrSold\"] - test[\"YearBuilt\"]\n",
    "\n",
    "sns.scatterplot(data=train, x=\"HouseAge\", y=\"SalePrice\")\n",
    "plt.show()\n",
    "\n",
    "X_exp_HouseAge =  X.copy()\n",
    "X_exp_HouseAge[\"HouseAge\"] = (\n",
    "    X_exp_HouseAge[\"YrSold\"] - X_exp_HouseAge[\"YearBuilt\"]\n",
    ")\n",
    "\n",
    "numeric_cols_exp = X_exp_HouseAge.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp_HouseAge.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp_HouseAge, y_log)\n",
    "\n",
    "#brief summary - among the Feature Engineering experiments, HouseAge showed the best result compared with the baseline\n",
    "# but the improvement was small\n",
    "\n",
    "train[\"YearsSinceRemod\"] = train[\"YrSold\"] - train[\"YearRemodAdd\"]\n",
    "train[[\"YearsSinceRemod\", \"SalePrice\"]].corr()\n",
    "\n",
    "test[\"YearsSinceRemod\"] = test[\"YrSold\"] - test[\"YearRemodAdd\"]\n",
    "\n",
    "X_exp_YearsSinceRemod = X.copy()\n",
    "X_exp_YearsSinceRemod[\"YearsSinceRemod\"] = (\n",
    "    X_exp_YearsSinceRemod[\"YrSold\"] - X_exp_YearsSinceRemod[\"YearRemodAdd\"]\n",
    ")\n",
    "\n",
    "sns.scatterplot(data=train, x=\"YearsSinceRemod\", y=\"SalePrice\")\n",
    "plt.show()\n",
    "\n",
    "numeric_cols_exp = X_exp_YearsSinceRemod.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp_YearsSinceRemod.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp_YearsSinceRemod, y_log)# Home remodeling does not provide additional useful information\n",
    "\n",
    "train.groupby(\"OverallQual\")[\"SalePrice\"].median()\n",
    "\n",
    "train.groupby(\"OverallCond\")[\"SalePrice\"].median()\n",
    "\n",
    "train[\"QualCondInteraction\"] = train[\"OverallQual\"] * train[\"OverallCond\"]\n",
    "train[[\"QualCondInteraction\", \"SalePrice\"]].corr()\n",
    "\n",
    "test[\"QualCondInteraction\"] = test[\"OverallQual\"] * test[\"OverallCond\"]\n",
    "\n",
    "sns.scatterplot(data=train, x=\"QualCondInteraction\", y=\"SalePrice\")\n",
    "plt.show()\n",
    "\n",
    "X_exp_QualCond = X.copy()\n",
    "\n",
    "X_exp_QualCond[\"QualCondInteraction\"] = (\n",
    "    X_exp_QualCond[\"OverallQual\"]\n",
    "    * X_exp_QualCond[\"OverallCond\"]\n",
    ")\n",
    "\n",
    "numeric_cols_exp = X_exp_QualCond.select_dtypes(include=np.number).columns\n",
    "categorical_cols_exp = X_exp_QualCond.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns\n",
    "\n",
    "preprocessor_exp = ColumnTransformer([\n",
    "    (\"num\", numeric_transformer, numeric_cols_exp),\n",
    "    (\"cat\", categorical_transformer, categorical_cols_exp)\n",
    "])\n",
    "\n",
    "model_exp = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_exp),\n",
    "    (\"regressor\", LinearRegression())\n",
    "])\n",
    "\n",
    "evaluate_model(model_exp, X_exp_QualCond, y_log)# Overall quality and current condition jointly affect the price.\n",
    "\n",
    "X_exp_11 = X.copy()\n",
    "\n",
    "X_exp_11[\"QualCondInteraction\"] = (\n",
    "    X_exp_11[\"OverallQual\"]\n",
