    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "sns.histplot(\n",
    "    error_df[\"Error\"],\n",
    "    bins=50,\n",
    "    kde=True\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Prediction Error\")\n",
    "plt.title(\"Distribution of Prediction Errors\")\n",
